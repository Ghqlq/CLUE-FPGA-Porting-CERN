  <parameter name="hdlParameters"><![CDATA[<hdlParameterDescriptorDefinitionList>
    <hdlParameterDescriptorDefinition>
        <description>The width of the address signal.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>KI_AV_ADDRESS_W</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>14</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>The width of an individual symbol. The default is an 8 bit Byte.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>KI_AV_SYMBOL_W</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>8</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>The number of symbols in a word. The default is 4 bytes per word.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>KI_AV_NUMSYMBOLS</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>4</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the waitrequest signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>KI_USE_WAIT_REQUEST</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>0</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>The width of the memory bank address signal.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>MBD_AV_ADDRESS_W</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>31</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>The width of an individual symbol. Only support 1 byte (8 bits)</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>MBD_AV_SYMBOL_W</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>8</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Set this value equal to memory bank data width / 8, i.e. size is 64 for width 512.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>MBD_AV_NUMSYMBOLS</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>4</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>This value is for memory transfer through memory bank divider for accurate memory model.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>MBD_AV_BURSTSIZE</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>16</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the waitrequest signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>MBD_USE_WAIT_REQUEST</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the burstcount signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>MBD_USE_BURST_COUNT</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the read signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_READ</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the write signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_WRITE</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the address signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_ADDRESS</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the byteenable signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_BYTE_ENABLE</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the readdata signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_READ_DATA</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use the readdatavalid signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_READ_DATA_VALID</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Use writedata signal</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>USE_WRITE_DATA</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Cycles of fixed read latency</description>
        <enabled>false</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>AV_FIX_READ_LATENCY</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>0</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Fixed read wait time (cycles)</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>AV_READ_WAIT_TIME</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>0</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Fixed write wait time (cycles)</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>AV_WRITE_WAIT_TIME</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>0</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Add one pipeline stage to the waitrequest to improve timing.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>REGISTER_WAITREQUEST</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>0</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Indicate that incoming signals come from register.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>AV_REGISTERINCOMINGSIGNALS</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>0</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Number of cycles to delay when there is no command from the host.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>COMMAND_WAIT_CYCLES</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>200</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Number of cycles to delay before the start of simulation.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>COMMAND_INITIAL_WAIT_CYCLES</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1000</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Number of cycles to wait after a read or write.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>COMMAND_READ_WRITE_CYCLES</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>4</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>The name of the component that contains the interface</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>STRING</parameterHdlType>
        <parameterName>COMPONENT_NAME</parameterName>
        <parameterType>java.lang.String</parameterType>
        <parameterValue>kernel_cra</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>Whether this is the CSR controller</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>IS_MAIN_CONTROLLER</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>1</parameterValue>
    </hdlParameterDescriptorDefinition>
    <hdlParameterDescriptorDefinition>
        <description>The number of components in the design that use the CSR for arguments.</description>
        <enabled>true</enabled>
        <exported>false</exported>
        <parameterHdlType>INTEGER</parameterHdlType>
        <parameterName>NUM_COMPONENTS_WITH_CSR</parameterName>
        <parameterType>java.lang.Integer</parameterType>
        <parameterValue>5</parameterValue>
    </hdlParameterDescriptorDefinition>
</hdlParameterDescriptorDefinitionList>]]></parameter>
